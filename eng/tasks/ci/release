#!/usr/bin/env bash
#MISE description="Publishes the tested release archives to GitHub"
set -euo pipefail

cd artifacts
sha256sum roslyn-for-clankers-* > SHA256SUMS

options=(--verify-tag --generate-notes)
if [[ "$RELEASE_TAG" == *-* ]]; then
  options+=(--prerelease --latest=false)
fi
gh release create "$RELEASE_TAG" roslyn-for-clankers-* SHA256SUMS "${options[@]}"
