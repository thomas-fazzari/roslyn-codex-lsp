# Ignore everything by default
*

# Except this
!/.gitignore
!/.editorconfig
!/.markdownlint-cli2.jsonc
!/.oxfmtrc.json
!/AGENTS.md
!/README.md
!/CHANGELOG.md
!/mise.toml
!/CodeMetricsConfig.txt
!/Directory.Build.props
!/Directory.Packages.props
!/Roslyn4Clankers.slnx
!/global.json
!/package.json
!/install.sh
!/install.ps1
!/bun.lock
!/lefthook.yml

!/.github/
!/.github/dependabot.yml
!/.github/workflows/
!/.github/workflows/docs.yml
!/.github/workflows/ci.yml
!/.vscode/
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/tasks.json

!/src/
!/src/**
!/tests/
!/tests/**
!/eng/
!/eng/**
!/docs/
!/docs/**
!/skills/
!/skills/roslyn-lsp/
!/skills/roslyn-lsp/SKILL.md
!/skills/roslyn-lsp/agents/
